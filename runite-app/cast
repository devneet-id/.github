      $dir    = $DESIGN . '/' . $name;
      $count  = design_user_count(design_user_groups($dir));
      $readme = file_exists($dir . '/README.md');
      $badge  = $readme
        ? "{{color-success}}{{icon-success}} readme"
        : "{{color-warning}}{{icon-warning}} no readme";
      Whisper::echo("{{color-info}} • {$name} {{color-secondary}}({$count} assets)  {$badge}{{color-end}}{{nl}}");
    }

    Whisper::echo("{{nl}}");
  }
);

/**
