// Image kinds a collection may hold.
function design_is_image(string $ext): bool {
  return in_array(strtolower($ext), ['svg', 'png', 'jpg', 'jpeg', 'gif', 'webp'], true);
}

// "v2-logo-1" -> "V2 Logo 1"
function design_titleize(string $name): string {
  return ucwords(trim(preg_replace('/[-_]+/', ' ', $name)));
}

// Collect image files directly inside $dir. Dedupe by name, preferring SVG.
// $prefix is prepended to each src (e.g. "main/").
function design_collect_images(string $dir, string $prefix): array {
  $seen = [];
  foreach (Forger::scan($dir) as $f) {
    if (is_dir($f['target'])) continue;
    $ext = strtolower($f['extension'] ?? '');
    if (!design_is_image($ext)) continue;

    $key = $f['filename'];
    $src = $prefix . $f['basename'];

    if (isset($seen[$key])) {
      if ($ext === 'svg') $seen[$key]['src'] = $src; // prefer vector
      continue;
    }
    $seen[$key] = ['name' => $key, 'src' => $src];
  }
  return array_values($seen);
}

// Group a collection's assets: loose files first, then one group per topic folder.
function design_user_groups(string $userDir): array {
  $groups = [];

  $root = design_collect_images($userDir, '');
  if ($root) $groups[''] = $root;

  $topics = [];
  foreach (Forger::scan($userDir) as $e) {
    if (!is_dir($e['target'])) continue;
    $topic = $e['basename'];
    $items = design_collect_images($e['target'], $topic . '/');
    if ($items) $topics[$topic] = $items;
  }
  ksort($topics);
  foreach ($topics as $k => $v) $groups[$k] = $v;

  return $groups;
}

// Total assets across all groups.
function design_user_count(array $groups): int {
  $n = 0;
  foreach ($groups as $items) $n += count($items);
  return $n;
}

// Engrave a single collection's README.md (gallery grouped by topic, 3 per row).
function design_user_markdown(string $username, array $groups): string {
  $md  = "[← Back to Design Gallery](../README.md)\n\n";
  $md .= "# {$username}\n\n";

  if (!$groups) {
    return $md . "_No assets yet._\n";
  }

  foreach ($groups as $topic => $items) {
    $heading = ($topic === '') ? 'Assets' : design_titleize($topic);
    $md .= "## {$heading}\n\n<table>\n  <tr>\n";

    $col = 0;
    foreach ($items as $it) {
      if ($col === 3) { $md .= "  </tr>\n  <tr>\n"; $col = 0; }
      $label = design_titleize($it['name']);
      $md .= "    <td align=\"center\">\n";
      $md .= "      <img src=\"{$it['src']}\" width=\"200\"><br>\n";
      $md .= "      <sub>{$label}</sub>\n";
      $md .= "    </td>\n";
      $col++;
    }

    $md .= "  </tr>\n</table>\n\n";
  }

  return rtrim($md) . "\n";
}

// List collection folders under design/ (skipping reserved names).
function design_collections(string $design, array $reserved): array {
  $out = [];
  foreach (Forger::scan($design) as $e) {
    if (!is_dir($e['target'])) continue;
    $name = $e['basename'];
    if (in_array($name, $reserved, true)) continue;
    $out[] = $name;
  }
  sort($out);
  return $out;
}

// Engrave design/README.md — the gallery index mapping every collection.
function design_index_markdown(array $rows): string {
  $md  = "# 🎨 Design Gallery\n\n";
  $md .= "A curated collection of visual concepts, explorations, and brand assets for DEVNEET. Browse the variations and compare directions that shape our visual identity.\n\n";
  $md .= "<p>\n";
  $md .= "  <img alt=\"Last updated\" src=\"https://img.shields.io/github/last-commit/devneet-id/.github?path=design&style=flat-square&label=last%20updated\">\n";
  $md .= "</p>\n\n";
  $md .= "## Collections\n\n";
  $md .= "| Collection | Concepts |\n| :--- | :--- |\n";
  foreach ($rows as $row) {
    [$name, $count] = $row;
    $md .= "| [{$name}]({$name}/README.md) | {$count} |\n";
  }
  $md .= "\n## Contributing\n\n";
  $md .= "Open the `design/` folder, then upload your own folder — that's it.\n";
  return $md;
}



