      Whisper::echo("{{nl}}{{color-failed}}{{icon-failed}} Collection '{$name}' not found.{{color-end}}{{nl}}{{nl}}");
      return;
    }

    $groups = design_user_groups($dir);
    Forger::item($dir . '/README.md', design_user_markdown($name, $groups));
    Whisper::echo("{{nl}}{{color-success}}{{icon-success}} {$name}: README written (" . design_user_count($groups) . " assets){{color-end}}{{nl}}{{nl}}");
  }
);


