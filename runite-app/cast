/**
 * CAST — design
 * Read each collection, generate any missing README, then rebuild the index.
 */
Chanter::cast(
  arg: 'design --check --force',
  echo: 'Sync the design gallery: generate missing collection READMEs and rebuild the index.',
  execute: function () use ($DESIGN, $RESERVED) {
    $check = (bool) Chanter::spell('check');
    $force = (bool) Chanter::spell('force');

    Whisper::echo("{{nl}}{{color-primary}} ✦ Design Gallery — Sync{{color-end}}{{nl}}");

    if (!is_dir($DESIGN)) {
      Whisper::echo("{{color-failed}}{{icon-failed}} design/ folder not found.{{color-end}}{{nl}}");
      return;
    }

    $collections = design_collections($DESIGN, $RESERVED);
    if (!$collections) {
      Whisper::echo("{{color-warning}}{{icon-warning}} No collections found.{{color-end}}{{nl}}");
      return;
    }

    $rows = [];
    foreach ($collections as $name) {
      $userDir = $DESIGN . '/' . $name;
      $groups  = design_user_groups($userDir);
      $count   = design_user_count($groups);
      $readme  = $userDir . '/README.md';
      $exists  = file_exists($readme);

      if (!$exists || $force) {
        if ($check) {
          $tag = $exists ? 'would update' : 'would create';
          Whisper::echo("{{color-info}}{{icon-info}} {$name}: {$tag} README {{color-secondary}}({$count} assets){{color-end}}{{nl}}");
        } else {
          Forger::item($readme, design_user_markdown($name, $groups));
          $tag = $exists ? 'updated' : 'created';
          Whisper::echo("{{color-success}}{{icon-success}} {$name}: {$tag} README {{color-secondary}}({$count} assets){{color-end}}{{nl}}");
        }
      } else {
        Whisper::echo("{{color-secondary}}{{icon-secondary}} {$name}: README ok ({$count} assets){{color-end}}{{nl}}");
      }

      $rows[] = [$name, $count];
    }

    if ($check) {
      Whisper::echo("{{nl}}{{color-info}}{{icon-info}} would rebuild design/README.md (" . count($rows) . " collections){{color-end}}{{nl}}");
    } else {
      Forger::item($DESIGN . '/README.md', design_index_markdown($rows));
      Whisper::echo("{{nl}}{{color-success}}{{icon-success}} rebuilt design/README.md (" . count($rows) . " collections){{color-end}}{{nl}}");
    }

    Whisper::echo("{{nl}}");
  }
);

